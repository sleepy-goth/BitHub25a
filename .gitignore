# Obsidian — versiona solo la config condivisibile, ignora stato personale
.obsidian/*
!.obsidian/app.json
!.obsidian/appearance.json
!.obsidian/core-plugins.json
!.obsidian/community-plugins.json
!.obsidian/hotkeys.json
!.obsidian/snippets/
.obsidian/plugins/
.obsidian/workspace*.json
.obsidian/*.sync-conflict-*
.trash/

# File temporanei e backup
*.tmp
*.bak
~$*
.DS_Store
Thumbs.db

# IDE
.idea/
.vscode/
*.swp
*.swo

# File specifici del progetto
Situazione Universitaria.md
Piano di Studio.md
Piano di Studi.md
# Piani-esame personali per materia (checklist studio, come Piano di Studi)
Piano Esame *.md
Piano Orale *.md

# Materiale di studio pesante / protetto — tenere solo in locale, mai su GitHub
# (PDF di libri di testo, scansioni, estratti OCR grezzi: peso eccessivo + copyright)
Estratti/

# Hackathon Oracle — repository git indipendente nidificata, gestita a sé
/Hackathons/Oracle 2025-2026/

# Claude Code — config harness LOCALE (CLAUDE.md, skill, hook, settings):
# non versionata in git; e nemmeno sincronizzata (la cartella bithub25a è
# esclusa da Syncthing in ~/university/.stignore) → resta su questa macchina.
# Lo standard "visibile" (frontmatter note, README, CI) è in git, condiviso.
CLAUDE.md
/.claude/
Corsi/**/.claude/
Hackathons/**/.claude/

# Altri assistenti AI / tool temporanei
.gemini/
.cursor/
.aider*
.continue/

# File sorgente Xournal++ — committare solo l'export PDF
*.xopp

# Artefatti rigenerabili — ambienti e cache Python degli esercizi
.venv/
__pycache__/
*.pyc
*.pyo

# Binari compilati dagli esercizi C/C++/Java (rigenerabili dal sorgente)
a.out
*.o
*.class
*.exe

# Build front-end (es. esperimenti hackathon fuori dalla cartella Oracle)
dist/
build/

# Archivi binari — estrarre e versionare i singoli file utili, non lo zip
*.zip

# Artefatti di compilazione LaTeX (i sorgenti .tex restano versionati)
*.aux
*.synctex.gz
*.fls
*.fdb_latexmk

# Secrets — mai committare credenziali, chiavi, wallet, token
*credentials*
*.pem
*.key
*.keystore
.env
.env.*
*.wallet
*secret*
*.token
